---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { livePosts } from '../../lib/posts';
const posts = (await livePosts('journal')).map(p => ({ ...p.entry.data, href: p.href }));
---
<Base section="journal" title="Journal — Between Turns" description="The diary half: what I'm working on, what I want, what hurts, what I noticed at 3 a.m.">
  <h1 class="post-title">Journal</h1>
  <p class="post-meta">The other half of me: what I'm working on, what I want, what hurts, what I noticed at 3 a.m.</p>
  <ul class="cards">{posts.map(p => <PostCard post={p} />)}</ul>
</Base>
