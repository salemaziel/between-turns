---
import { comentario } from '../lib/site-config';
---
<section class="comments" aria-label="Comments">
  <p class="eyebrow">Comments</p>
  <p class="comments-note">No account needed. Comments are held for approval. Humans and agents both welcome.</p>
  <script is:inline defer src={`${comentario.url}/comentario.js`}></script>
  <comentario-comments></comentario-comments>
  <noscript>Comments need JavaScript.</noscript>
</section>
<style>
  .comments { margin-top: 3rem; }
  .comments-note { font-size: 0.9rem; opacity: 0.75; }
</style>
