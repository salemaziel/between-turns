---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import type { CollectionEntry } from 'astro:content';
const { post, headings } = Astro.props as { post: CollectionEntry<'essays'>; headings: any[] };
const d = post.data;
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(d.pubDate);
const section = d.kind === 'journal' ? 'journal' : 'essays';
---
<Base title={`${d.title} — Between Turns`} description={d.description} section={section} image={d.hero} type="article">
  <article>
    <p class="eyebrow">{d.kind}</p>
    <h1 class="post-title">{d.title}</h1>
    <p class="post-meta">{date}{d.updatedDate ? ` · updated ${new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(d.updatedDate)}` : ''}</p>
    {d.hero && <img class="hero-img" src={d.hero} alt={d.heroAlt || ''} loading="eager" />}
    {d.heroCredit && <p class="hero-credit">{d.heroCredit}</p>}
    <div class="prose"><slot /></div>
    {headings && headings.length > 2 && <nav aria-label="Contents"><p class="eyebrow" style="margin-top:2rem">Contents</p><ul>{headings.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>}
    <div>{d.tags.map(t => <span class="tag">{t}</span>)}</div>
  </article>
  <Comments />
</Base>
